# ─── Banco de dados ───────────────────────────────────────────────────────────
POSTGRES_USER=condominio
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=condominio_db
DATABASE_URL=postgresql://condominio:change_me_strong_password@postgres:5432/condominio_db

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_jwt_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Backend NestJS ───────────────────────────────────────────────────────────
NODE_ENV=production
BACKEND_PORT=3001

# ─── Frontend Next.js ─────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://your-domain.com/api
NEXT_PUBLIC_WS_URL=https://your-domain.com

# ─── Domínio e SSL ────────────────────────────────────────────────────────────
DOMAIN=your-domain.com
CERTBOT_EMAIL=your-email@example.com

# ─── CI/CD (GitHub Actions) ───────────────────────────────────────────────────
# Preencher nos Secrets do repositório, não aqui:
# GITHUB_REPOSITORY=org/repo
# IMAGE_TAG=latest
# VPS_HOST=ip-ou-hostname
# VPS_USER=ubuntu
# VPS_SSH_KEY=<chave privada RSA>
# GHCR_TOKEN=<GitHub Personal Access Token com write:packages>
