# ─── Banco de dados ───────────────────────────────────────────────────────────
POSTGRES_USER=condominio
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=condominio_db
DATABASE_URL=postgresql://condominio:change_me_strong_password@postgres:5432/condominio_db

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_jwt_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Backend NestJS ───────────────────────────────────────────────────────────
NODE_ENV=production
BACKEND_PORT=3001

# ─── Frontend Next.js ─────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://your-domain.com/api
NEXT_PUBLIC_WS_URL=https://your-domain.com

# ─── Oracle MCP Remoto (OAuth via mcp-remote) ───────────────────────────────
# Nome do servidor no bloco mcpServers do cliente MCP (Codex/VS Code)
ORACLE_MCP_SERVER_NAME=oracle_adb_mcp_server

# Descricao exibida no cliente MCP
ORACLE_MCP_DESCRIPTION=Oracle Autonomous Database MCP server (OAuth)

# URL remota completa opcional. Se vazia, sera montada por region + database OCID.
ORACLE_MCP_REMOTE_URL=

# Necessario quando ORACLE_MCP_REMOTE_URL nao estiver preenchida
ORACLE_ADB_REGION=sa-saopaulo-1
ORACLE_ADB_DATABASE_OCID=ocid1.autonomousdatabase.oc1..change_me

# Seguranca: manter false por padrao. Use true apenas para debug local com HTTP.
ORACLE_MCP_ALLOW_HTTP=false

# ─── Domínio e SSL ────────────────────────────────────────────────────────────
DOMAIN=your-domain.com
CERTBOT_EMAIL=your-email@example.com

# ─── CI/CD (GitHub Actions) ───────────────────────────────────────────────────
# Necessário para pull das imagens GHCR em produção:
GITHUB_REPOSITORY=org/repo
IMAGE_TAG=latest
#
# Também preencha estes no ambiente de deploy/Secrets:
# VPS_HOST=ip-ou-hostname
# VPS_USER=ubuntu
# VPS_SSH_KEY=<chave privada RSA>
# GHCR_TOKEN=<GitHub Personal Access Token com write:packages>
