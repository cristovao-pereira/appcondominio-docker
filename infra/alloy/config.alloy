// Coleta de métricas do sistema host (equivalente ao Node Exporter)
prometheus.exporter.unix "host" {
  set_collectors = ["cpu", "meminfo", "diskstats", "filesystem", "netdev"]
}

// Coleta de métricas dos containers Docker locais
prometheus.exporter.cadvisor "docker" {
  docker_host = "unix:///var/run/docker.sock"
}

discovery.relabel "host" {
  targets = prometheus.exporter.unix.host.targets
  rule {
    target_label = "job"
    replacement  = "node"
  }
  rule {
    target_label = "instance"
    replacement  = "appcondominio-server"
  }
  rule {
    target_label = "nodename"
    replacement  = "appcondominio-server"
  }
}

discovery.relabel "docker" {
  targets = prometheus.exporter.cadvisor.docker.targets
  rule {
    target_label = "job"
    replacement  = "cadvisor"
  }
  rule {
    target_label = "instance"
    replacement  = "appcondominio-server"
  }
}

// Agrupamento e raspagem das métricas do Host
prometheus.scrape "host_metrics" {
  targets    = discovery.relabel.host.output
  forward_to = [prometheus.remote_write.grafana_cloud.receiver]
  job_name   = "node"
}

// Agrupamento e raspagem das métricas dos Containers
prometheus.scrape "docker_metrics" {
  targets    = discovery.relabel.docker.output
  forward_to = [prometheus.remote_write.grafana_cloud.receiver]
  job_name   = "cadvisor"
}

// Envio remoto seguro para o Grafana Cloud
prometheus.remote_write "grafana_cloud" {
  endpoint {
    url = sys.env("GRAFANA_CLOUD_PROMETHEUS_URL")

    basic_auth {
      username = sys.env("GRAFANA_CLOUD_PROMETHEUS_USER")
      password = sys.env("GRAFANA_CLOUD_API_KEY")
    }
  }
}
